generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Each account's bot-match settings (table + agents); shape is validated by normalize() in lib/config.ts.
model Settings {
  userId String @id @map("user_id")
  config Json
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

/// One key per provider ("anthropic" | "openai" | "openrouter") plus optional per-seat overrides ("seat:0".."seat:8").
model ApiKey {
  userId    String   @map("user_id") // keys belong to one account: nobody else's bot seats can spend them
  id        String
  key       String
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@map("api_keys")
}

/// One finished hand, as the table saw it (board, actions, winners, shown cards). Never the remaining deck.
model Hand {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") // whose bot match it was; each account sees only its own history
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String   @map("game_id")
  number    Int
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([gameId, number])
  @@index([userId, createdAt])
  @@map("hands")
}

/// A player-built agent: its persona prompt, model settings, and the canvas it was built on (see lib/built-agents.ts).
model Agent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") // only this account can read, edit, test or delete it
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  prompt    String
  provider  String
  model     String
  effort    String
  layout    Json // node positions and wires, for drawing the canvas only
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, updatedAt])
  @@map("agents")
}

/// A human-only table, found by its invite code. `data` holds the whole game (deck and every hand), so it is never sent to players as-is.
model Table {
  code      String   @id
  data      Json
  version   Int      @default(0) // optimistic lock: a write only lands if nobody changed the table since it was read
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tables")
}

// ---- Better Auth (generated with `npx auth generate --adapter prisma --dialect postgresql`; createdAt index added for the hash-account cap) ----

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  settings      Settings?
  apiKeys       ApiKey[]
  hands         Hand[]
  agents        Agent[]

  @@unique([email])
  @@index([createdAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
