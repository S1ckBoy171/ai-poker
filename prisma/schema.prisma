generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Single row with table + agent settings; shape is validated by normalize() in lib/config.ts.
model Settings {
  id     Int  @id @default(1)
  config Json

  @@map("settings")
}

/// One key per provider ("anthropic" | "openai" | "openrouter") plus optional per-seat overrides ("seat:0".."seat:8").
model ApiKey {
  id        String   @id
  key       String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("api_keys")
}

/// One finished hand, as the table saw it (board, actions, winners, shown cards). Never the remaining deck.
model Hand {
  id        Int      @id @default(autoincrement())
  gameId    String   @map("game_id")
  number    Int
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([gameId, number])
  @@index([createdAt])
  @@map("hands")
}

/// A human-only table, found by its invite code. `data` holds the whole game (deck and every hand), so it is never sent to players as-is.
model Table {
  code      String   @id
  data      Json
  version   Int      @default(0) // optimistic lock: a write only lands if nobody changed the table since it was read
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tables")
}
