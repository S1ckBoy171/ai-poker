# Copy to .env: cp .env.example .env
# API keys don't go here: add them in the app (Settings or the home page); they are stored in the database, per account.

# Signs sessions; make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The address you open the app at
BETTER_AUTH_URL="http://localhost:3000"

# Postgres connection; `docker compose up -d` starts this one
DATABASE_URL="postgresql://poker:poker@localhost:5432/poker"

# Optional: how many hash accounts the whole server may create per hour (default 30)
# HASH_ACCOUNTS_PER_HOUR=30

# Cloudflare Turnstile CAPTCHA on sign-up. These are Cloudflare's always-pass TEST keys: fine locally,
# replace both with your own (dash.cloudflare.com > Turnstile) before going online, then rebuild.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Set for you by `npm run friends`: opens the server to your network and switches off bot matches and key routes
# FRIENDS_ONLY=1
